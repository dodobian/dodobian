/* Dodobian Waybar style, "Mauritius" palette, light. SPDX-License-Identifier: GPL-2.0-or-later */
* { font-family: "Noto Sans", "Font Awesome 6 Free"; font-size: 13px; border-radius: 0; min-height: 0; }
window#waybar { background: @@panel@@; color: @@text@@; }
window#waybar.top { border-bottom: 1px solid @@border@@; }
window#waybar.bottom { border-top: 1px solid @@border@@; }
button { border: none; box-shadow: none; text-shadow: none; background: transparent; color: @@text@@; }
#custom-apps, #custom-places, #custom-system, #custom-desktop, #tray, #pulseaudio, #clock { padding: 0 10px; }
#custom-apps { font-weight: bold; padding-left: 32px;
  background-image: url("/usr/share/dodobian/brand/dmark-swirl.svg");
  background-size: 18px 18px; background-repeat: no-repeat; background-position: 9px center; }
#custom-apps:hover, #custom-places:hover, #custom-system:hover, #custom-desktop:hover { background-color: @@hover@@; border-radius: 6px; }
#taskbar button { margin: 3px 2px; padding: 0 9px; border: 1px solid @@border@@; border-bottom-width: 3px; border-radius: 6px; background: @@btn@@; }
#taskbar button:hover { background: @@hover@@; }
#taskbar button.active { background: @@sel@@; border-color: @@sel-border@@; border-bottom-color: @@primary@@; color: @@sel-fg@@; }
#taskbar button.minimized { background: transparent; color: @@muted@@; font-style: italic; }
#workspaces button { margin: 3px 1px; padding: 0 10px; border-bottom: 3px solid transparent; border-radius: 6px; }
#workspaces button:hover { background: @@hover@@; }
#workspaces button.active { background: @@sel@@; border-bottom-color: @@primary@@; color: @@sel-fg@@; font-weight: bold; }
menu { background: @@win@@; color: @@text@@; border: 1px solid @@border@@; border-radius: 8px; }
menuitem { padding: 6px 12px; border-radius: 5px; }
menuitem:hover { background: @@sel@@; color: @@sel-fg@@; }
tooltip { background: @@win@@; border: 1px solid @@border@@; border-radius: 6px; }
tooltip label { color: @@text@@; }

/* Desktop-switch indicator (LG only): the number of the desktop just entered, then it fades out.
   Do not call this bar "osd": that is a built-in Adwaita class and paints a dark square. */
@keyframes pd-osd {
  0%   { background-color: @@win@@; color: @@text@@; border-top-color: @@primary@@; border-left-color: @@primary@@; border-right-color: @@primary@@; border-bottom-color: @@primary@@; }
  65%  { background-color: @@win@@; color: @@text@@; border-top-color: @@primary@@; border-left-color: @@primary@@; border-right-color: @@primary@@; border-bottom-color: @@primary@@; }
  100% { background-color: @@win rgba 0@@; color: @@text rgba 0@@; border-top-color: @@primary rgba 0@@; border-left-color: @@primary rgba 0@@; border-right-color: @@primary rgba 0@@; border-bottom-color: @@primary rgba 0@@; }
}
window#waybar.deskpop { background: transparent; border: none; }
window#waybar.deskpop #workspaces button,
window#waybar.deskpop #workspaces button:hover {
  padding: 0; margin: 0; min-width: 0; border: none; outline: none; box-shadow: none; text-shadow: none;
  background-image: none; background-color: transparent; color: transparent; font-weight: normal;
}
window#waybar.deskpop #workspaces button label { font-size: 1px; }
window#waybar.deskpop #workspaces button.active,
window#waybar.deskpop #workspaces button.active:hover {
  min-width: 110px; min-height: 96px; border-style: solid; border-width: 1px 1px 5px 1px; border-color: transparent; border-radius: 14px;
  animation-name: pd-osd; animation-duration: 1.1s; animation-timing-function: linear; animation-iteration-count: 1;
}
window#waybar.deskpop #workspaces button.active label { font-size: 46px; font-weight: bold; }
