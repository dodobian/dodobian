# Dodobian labwc theme, "Mauritius" palette, light. SPDX-License-Identifier: GPL-2.0-or-later
border.width: 1
window.titlebar.padding.width: 4
window.titlebar.padding.height: 3
window.button.width: 26
window.button.height: 26
window.button.spacing: 2
window.button.hover.bg.corner-radius: 13
window.label.text.justify: center
window.active.title.bg.color: @@title-on@@
window.inactive.title.bg.color: @@title@@
window.active.label.text.color: @@text@@
window.inactive.label.text.color: @@muted@@
window.active.border.color: @@primary@@
window.inactive.border.color: @@border@@
window.active.button.unpressed.image.color: @@text@@
window.inactive.button.unpressed.image.color: @@faint@@
window.button.hover.bg.color: @@primary/26@@
window.active.indicator.toggled-keybind.color: @@danger@@
window.active.shadow.size: 44
window.inactive.shadow.size: 26
window.active.shadow.color: @@shadow/66@@
window.inactive.shadow.color: @@shadow/38@@
menu.border.width: 1
menu.items.padding.x: 12
menu.items.padding.y: 6
menu.width.max: 320
menu.border.color: @@border@@
menu.items.bg.color: @@win@@
menu.items.text.color: @@text@@
menu.items.active.bg.color: @@sel@@
menu.items.active.text.color: @@sel-fg@@
menu.separator.color: @@line@@
menu.title.bg.color: @@title-on@@
menu.title.text.color: @@text@@
osd.border.width: 1
osd.bg.color: @@win@@
osd.border.color: @@primary@@
osd.label.text.color: @@text@@
snapping.overlay.region.border.color: @@primary@@
snapping.overlay.edge.border.color: @@primary@@
magnifier.border.color: @@primary@@
osd.window-switcher.style-classic.item.active.bg.color: @@sel@@
osd.window-switcher.style-classic.item.active.border.color: @@primary@@
osd.window-switcher.style-thumbnail.item.active.bg.color: @@sel@@
osd.window-switcher.style-thumbnail.item.active.border.color: @@primary@@
