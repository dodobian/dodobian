# Desktop icons and wallpaper. Started by dodo-session.target only.
[Unit]
Description=Dodo desktop icons and wallpaper (xfdesktop)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xfdesktop
Restart=on-failure
RestartSec=1
