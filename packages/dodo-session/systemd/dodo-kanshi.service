# Output layouts per set of monitors, when the user has written them (~/.config/kanshi/config).
[Unit]
Description=Dodo output layouts (kanshi)
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=%h/.config/kanshi/config

[Service]
ExecStart=/usr/bin/kanshi
Restart=on-failure
