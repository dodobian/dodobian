#
# power logout|reboot|poweroff: the panel's System menu.
case ${1:-} in
logout) exec labwc --exit ;;
reboot) exec systemctl reboot ;;
poweroff) exec systemctl poweroff ;;
*) echo "usage: ${0##*/} logout|reboot|poweroff" >&2; exit 2 ;;
esac
