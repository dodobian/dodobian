#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 The Dodobian authors
#
# gen-labwc <dir> [pinned-output]
# Write the login-time labwc layer <dir>/rc.xml for a pinned output: its windows show on every
# desktop, while the other outputs switch desktops. It names only the pinned output, never the others.
# labwc --merge-config reads it over the package defaults and under the user's own rc.xml.
# Without a pinned output nothing is written.
set -eu
dir=$1
P=${2:-}
[ -n "$P" ] || exit 0
case $P in
*[!A-Za-z0-9._-]*) echo "gen-labwc: not an output name: $P" >&2; exit 1 ;;
esac
mkdir -p "$dir"

toggle='<action name="ToggleOmnipresent"/>'
# Windows on the pinned output: on every desktop. Windows elsewhere: on one desktop.
pin="<action name=\"ForEach\"><query monitor=\"$P\" omnipresent=\"no\" desktop=\"current\"/><then>$toggle</then></action>"
pin="$pin<action name=\"ForEach\"><query monitor=\"$P\"/><else><action name=\"If\"><query omnipresent=\"yes\"/><then>$toggle</then></action></else></action>"
# Every window back to one desktop: before a switch on all outputs.
unpin="<action name=\"ForEach\"><query omnipresent=\"yes\" desktop=\"current\"/><then>$toggle</then></action>"
# The pager switches on press, before any binding runs. A window just dragged to the pinned output
# (an interactive move swallows its release binding) would stay behind on the previous desktop:
# bring it along when the button is released.
rescue="<action name=\"ForEach\"><query monitor=\"$P\" omnipresent=\"no\" desktop=\"last\"/><then><action name=\"SendToDesktop\" to=\"current\" follow=\"no\"/>$toggle</then></action>"
release="$pin$rescue"

keys=
for i in 1 2 3 4; do
	go="<action name=\"GoToDesktop\" to=\"$i\"/>"
	keys="$keys
    <keybind key=\"W-$i\">$pin$go</keybind>
    <keybind key=\"W-C-$i\">$unpin$go</keybind>
    <keybind key=\"W-S-$i\"><action name=\"If\"><query monitor=\"$P\"/><else><action name=\"SendToDesktop\" to=\"$i\" follow=\"no\"/></else></action></keybind>"
done
for d in Left Right; do
	lower=$(printf '%s' "$d" | tr 'LR' 'lr')
	keys="$keys
    <keybind key=\"W-$d\">$pin<action name=\"GoToDesktop\" to=\"$lower\" wrap=\"yes\"/></keybind>"
done

tmp="$dir/rc.xml.tmp"
cat > "$tmp" <<EOF
<?xml version="1.0"?>
<!-- Generated at login by dodo-session from session.conf (pinned=$P). Do not edit:
     put your own settings in ~/.config/labwc/rc.xml, they win over this file. -->
<labwc_config>
  <!-- labwc's desktop popup shows on every output or on none: off, the panel shows it instead. -->
  <desktops popupTime="0"/>
  <keyboard>$keys
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind direction="Up" action="Scroll">$pin<action name="GoToDesktop" to="left" wrap="yes"/></mousebind>
      <mousebind direction="Down" action="Scroll">$pin<action name="GoToDesktop" to="right" wrap="yes"/></mousebind>
    </context>
    <context name="All">
      <mousebind button="Left" action="Release">$release</mousebind>
      <mousebind button="Right" action="Release">$release</mousebind>
      <mousebind button="Middle" action="Release">$release</mousebind>
    </context>
  </mouse>
  <windowRules>
    <windowRule identifier="*">$pin</windowRule>
  </windowRules>
</labwc_config>
EOF
mv "$tmp" "$dir/rc.xml"
