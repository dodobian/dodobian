  The desktop menu (right click on the desktop, Super+A). Under merge-config the first menu with a
  given id wins and the system layer is read before the user's, so ours has its own id: to use a
  menu of your own, bind it in ~/.config/labwc/rc.xml.
-->
<openbox_menu>
  <menu id="dodo-root-menu" label="Dodo">
    <item label="Find an app..."><action name="Execute" command="fuzzel"/></item>
    <item label="Files"><action name="Execute" command="thunar"/></item>
    <item label="Terminal"><action name="Execute" command="xdg-terminal-exec"/></item>
    <menu id="dodo-apps" label="Applications" execute="labwc-menu-generator -I"/>
    <separator/>
    <item label="Displays"><action name="Execute" command="wdisplays"/></item>
    <item label="Reload settings"><action name="Reconfigure"/></item>
    <item label="Log out"><action name="Exit"/></item>
  </menu>
</openbox_menu>
