  Dodo defaults for labwc, read with merge-config: a user's ~/.config/labwc/rc.xml is read
  after this file and wins element by element (a key bound there replaces the binding here, an
  empty keybind removes it). Monitor-specific settings come from session.conf, never from here.
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <!-- Games: variable refresh rate and tearing only for fullscreen windows. -->
    <adaptiveSync>fullscreen</adaptiveSync>
    <allowTearing>fullscreen</allowTearing>
  </core>
  <placement><policy>cascade</policy></placement>
  <theme>
    <name>Dodo</name>
    <icon>Papirus-Light</icon>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar><layout>icon:iconify,max,close</layout><showTitle>yes</showTitle></titlebar>
    <font><name>Noto Sans</name><size>10</size></font>
  </theme>
  <windowSwitcher><osd show="yes" style="thumbnail" output="cursor"/></windowSwitcher>
  <desktops number="4"><names><name>1</name><name>2</name><name>3</name><name>4</name></names></desktops>
  <focus><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>
  <keyboard>
    <numlock>on</numlock>
    <layoutScope>window</layoutScope>
    <repeatRate>35</repeatRate>
    <repeatDelay>250</repeatDelay>
    <!-- labwc's own bindings first (volume and brightness keys, Alt+Tab, Alt+F4...), ours over them. -->
    <default/>
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no"/></keybind>
    <keybind key="W-Left"><action name="GoToDesktop" to="left" wrap="yes"/></keybind>
    <keybind key="W-Right"><action name="GoToDesktop" to="right" wrap="yes"/></keybind>
    <keybind key="W-Up"><action name="Maximize"/></keybind>
    <keybind key="W-Down"><action name="Iconify"/></keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="W-Space"><action name="Execute" command="fuzzel"/></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot"/></keybind>
    <keybind key="W-e"><action name="Execute" command="thunar"/></keybind>
    <keybind key="W-a"><action name="ShowMenu" menu="dodo-root-menu"/></keybind>
    <keybind key="Print"><action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; - | swappy -f -'"/></keybind>
  </keyboard>
  <mouse>
    <default/>
    <context name="Root">
      <mousebind button="Left" action="Press"/>
      <mousebind button="Right" action="Press"><action name="ShowMenu" menu="dodo-root-menu"/></mousebind>
      <mousebind direction="Up" action="Scroll"><action name="GoToDesktop" to="left" wrap="yes"/></mousebind>
      <mousebind direction="Down" action="Scroll"><action name="GoToDesktop" to="right" wrap="yes"/></mousebind>
    </context>
    <context name="Frame">
      <mousebind button="W-Left" action="Press"><action name="Focus"/><action name="Raise"/></mousebind>
      <mousebind button="W-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="W-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
  </mouse>
  <windowRules>
    <!-- Rename from the desktop (xfdesktop hands it to Thunar): open under the pointer, not centred.
         Matched by title: the window can be maximized, so labwc does not count it as a dialog. -->
    <windowRule identifier="thunar" title="Rename*"><action name="AutoPlace" policy="cursor"/></windowRule>
  </windowRules>
</labwc_config>
