--- a/libxfce4windowing/xfw-monitor.c
+++ b/libxfce4windowing/xfw-monitor.c
@@ -1130,9 +1130,42 @@
     }
 }
 
+// The session names the primary monitor in XFW_PRIMARY_MONITOR: one connector name, or several
+// separated by commas, the first connected one winning (e.g. "DP-2,eDP-1" for a docked laptop).
+// Only Xfce's own compositor can tell us the primary output over Wayland; under any other
+// compositor this is the only way to choose it instead of guessing.
+static XfwMonitor *
+primary_monitor_from_environment(GList *monitors) {
+    const char *wanted = g_getenv("XFW_PRIMARY_MONITOR");
+    if (wanted == NULL || *wanted == '\0') {
+        return NULL;
+    }
+
+    XfwMonitor *found = NULL;
+    gchar **names = g_strsplit(wanted, ",", -1);
+    for (gchar **name = names; found == NULL && *name != NULL; name++) {
+        g_strstrip(*name);
+        if (**name == '\0') {
+            continue;
+        }
+        for (GList *l = monitors; l != NULL; l = l->next) {
+            const char *connector = xfw_monitor_get_connector(XFW_MONITOR(l->data));
+            if (connector != NULL && strcmp(connector, *name) == 0) {
+                found = XFW_MONITOR(l->data);
+                break;
+            }
+        }
+    }
+    g_strfreev(names);
+    return found;
+}
