@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_VIEW_FX_H
+#define LABWC_VIEW_FX_H
+
+struct view;
+
+/*
+ * Rounded corners on all four sides and drop shadows, drawn by SceneFX.
+ *
+ * view_fx_update() brings the corner radii of the view's client buffers
+ * (in the scene and in the toplevel capture scene) and its shadow node in
+ * line with the view's state. It is cheap when nothing changed, so it is
+ * called once per output frame for every mapped view, which also catches
+ * subsurfaces and buffers that clients add or resize on their own.
+ */
+void view_fx_update(struct view *view);
+void view_fx_update_all(void);
+
+#endif /* LABWC_VIEW_FX_H */
