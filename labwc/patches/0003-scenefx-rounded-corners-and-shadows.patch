diff --git a/src/ssd/ssd-border.c b/src/ssd/ssd-border.c
index 13d47f9..186913f 100644
--- a/src/ssd/ssd-border.c
+++ b/src/ssd/ssd-border.c
@@ -129,6 +129,47 @@ ssd_border_update(struct ssd *ssd)
 		? 0
 		: theme->border_width + corner_width;
 
+	/*
+	 * Rounded bottom corners (all four without a titlebar), drawn by
+	 * SceneFX. The bottom border rect (and the top one without a
+	 * titlebar) grows to the corner radius and follows the rounded
+	 * outline; the window area is clipped out of it with the inner
+	 * radius, so the border keeps its width around the rounded content
+	 * (see view-fx.c). The top corners with a titlebar are the cairo
+	 * corner buffers of the titlebar.
+	 */
+	int bw = theme->border_width;
+	int band = MAX(bw, rc.corner_radius);
+	bool no_title = ssd->titlebar.height <= 0;
+	bool rounded = !ssd->state.was_squared && !view->shaded
+		&& bw > 0 && rc.corner_radius > 0
+		&& height >= (no_title ? 2 * band : band);
+	int inner = MAX(rc.corner_radius - bw, 0);
+	int bottom_y = rounded ? height + bw - band : height;
+	int bottom_height = rounded ? band : bw;
+	struct clipped_region bottom_clip = clipped_region_get_default();
+	struct clipped_region top_clip = clipped_region_get_default();
+	struct fx_corner_radii bottom_corners = corner_radii_none();
+	struct fx_corner_radii top_corners = corner_radii_none();
+	if (rounded) {
+		bottom_corners = corner_radii_bottom(rc.corner_radius);
+		bottom_clip = (struct clipped_region){
+			.area = { bw, -bottom_y, width, height },
+			.corners = corner_radii_bottom(inner),
+		};
+		side_height = bottom_y - side_y;
+		if (no_title) {
+			top_corners = corner_radii_top(rc.corner_radius);
+			top_clip = (struct clipped_region){
+				.area = { bw, bw, width, height },
+				.corners = corner_radii_top(inner),
+			};
+			side_y = band - bw;
+			side_height = bottom_y - side_y;
+		}
+	}
+	int top_height = rounded && no_title ? band : bw;
+
 	enum ssd_active_state active;
 	FOR_EACH_ACTIVE_STATE(active) {
 		struct ssd_border_subtree *subtree = &ssd->border.subtrees[active];
@@ -144,14 +185,18 @@ ssd_border_update(struct ssd *ssd)
 			theme->border_width + width, side_y);
 
 		wlr_scene_rect_set_size(subtree->bottom,
-			full_width, theme->border_width);
+			full_width, bottom_height);
 		wlr_scene_node_set_position(&subtree->bottom->node,
-			0, height);
+			0, bottom_y);
+		wlr_scene_rect_set_corner_radii(subtree->bottom, bottom_corners);
+		wlr_scene_rect_set_clipped_region(subtree->bottom, bottom_clip);
 
 		wlr_scene_rect_set_size(subtree->top,
-			top_width, theme->border_width);
+			top_width, top_height);
 		wlr_scene_node_set_position(&subtree->top->node,
 			top_x, -(ssd->titlebar.height + theme->border_width));
+		wlr_scene_rect_set_corner_radii(subtree->top, top_corners);
+		wlr_scene_rect_set_clipped_region(subtree->top, top_clip);
 	}
 }
 
