diff --git a/src/view-fx.c b/src/view-fx.c
new file mode 100644
index 0000000..87ab456
--- /dev/null
+++ b/src/view-fx.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Rounded corners on all four sides and drop shadows, drawn by SceneFX
+ *
+ * Copyright (C) 2026 The Dodobian authors
+ *
+ * Corners: SceneFX rounds each scene buffer on its own, so a corner radius
+ * is given to every client buffer that covers a corner of the window, for
+ * that corner only: the titlebar subsurface of a client-side decorated
+ * window gets the top corners, the main surface the bottom ones, a video
+ * subsurface in the middle of the window none. With server-side
+ * decorations the content gets the inner radius below the border, whose
+ * rounded bottom is drawn by ssd-border.c; the top corners belong to the
+ * titlebar.
+ *
+ * Clients that draw their own frame (the main surface sticks out of the
+ * window geometry on the top or left, as GTK4 does for its shadow and
+ * resize margin) are left alone: no radius and no shadow from us.
+ *
+ * The toplevel capture scene (ext-image-copy-capture of a window) holds a
+ * copy of the client surfaces without decorations; it is rounded on all
+ * four sides with the window radius.
+ *
+ * Shadow: one SceneFX shadow node at the bottom of view->scene_tree. Its
+ * shape is the node shrunk by blur_sigma on every side, so the node is the
+ * window outline grown by sigma, moved by the theme offset; the outline
+ * itself is clipped out so nothing is drawn under translucent windows.
+ */
+
+#include "view-fx.h"
+#include <scenefx/types/wlr_scene.h>
+#include <wlr/types/wlr_compositor.h>
+#include "common/border.h"
+#include "common/macros.h"
+#include "common/mem.h"
+#include "config/rcxml.h"
+#include "labwc.h"
+#include "ssd.h"
+#include "theme.h"
+#include "view.h"
+
+struct buffer_walk {
+	struct wlr_surface *root; /* main surface of the view */
+	int origin_x, origin_y; /* window origin in walk coordinates */
+	int width, height; /* window geometry size */
+	struct fx_corner_radii radii; /* radius of each window corner */
+	bool client_frame; /* the main surface sticks out of the window */
+};
+
+static void
+find_client_frame(struct wlr_scene_buffer *buffer, int sx, int sy, void *data)
+{
+	struct buffer_walk *walk = data;
+	struct wlr_scene_surface *scene_surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	if (scene_surface && scene_surface->surface == walk->root
+			&& (sx < walk->origin_x || sy < walk->origin_y)) {
+		walk->client_frame = true;
+	}
+}
+
+static void
+round_buffer(struct wlr_scene_buffer *buffer, int sx, int sy, void *data)
+{
+	struct buffer_walk *walk = data;
+	struct wlr_scene_surface *scene_surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	if (!scene_surface || wlr_surface_get_root_surface(
+			scene_surface->surface) != walk->root) {
+		/* Popups, and child toplevels in the capture scene */
+		return;
+	}
+
+	int w = buffer->dst_width;
+	int h = buffer->dst_height;
+	if ((w <= 0 || h <= 0) && buffer->buffer) {
+		w = buffer->buffer->width;
+		h = buffer->buffer->height;
+	}
+	int x = sx - walk->origin_x;
+	int y = sy - walk->origin_y;
+	bool left = x <= 0 && x + w > 0;
+	bool right = x < walk->width && x + w >= walk->width;
+	bool top = y <= 0 && y + h > 0;
+	bool bottom = y < walk->height && y + h >= walk->height;
+	int max = MAX(MIN(w, h) / 2, 0);
+
+	struct fx_corner_radii radii = corner_radii_new(
+		top && left ? MIN(walk->radii.top_left, max) : 0,
+		top && right ? MIN(walk->radii.top_right, max) : 0,
+		bottom && right ? MIN(walk->radii.bottom_right, max) : 0,
+		bottom && left ? MIN(walk->radii.bottom_left, max) : 0);
+	wlr_scene_buffer_set_corner_radii(buffer, radii);
+}
+
+/* Returns true if the client draws its own frame around the window */
+static bool
+round_tree(struct wlr_scene_node *node, struct buffer_walk *walk)
+{
+	/* The walk includes the position of the node it starts from */
+	walk->origin_x = node->x;
+	walk->origin_y = node->y;
+	walk->client_frame = false;
+	wlr_scene_node_for_each_buffer(node, find_client_frame, walk);
+	if (walk->client_frame) {
+		walk->radii = corner_radii_none();
+	}
+	wlr_scene_node_for_each_buffer(node, round_buffer, walk);
+	return walk->client_frame;
+}
+
+/* Radius of the window outline, 0 where Labwc squares the corners */
+static int
+window_radius(struct view *view)
+{
+	if (view->fullscreen || view->maximized == VIEW_AXIS_BOTH
+			|| view_is_tiled_and_notify_tiled(view)) {
+		return 0;
+	}
+	/* As ssd_should_be_squared(): too narrow for the titlebar corners */
+	if (view->ssd && view->current.width < 2 * ssd_get_corner_width()) {
+		return 0;
+	}
+	return MAX(rc.corner_radius, 0);
+}
+
+static bool
+want_shadow(struct view *view)
+{
+	if (!rc.shadows_enabled || view->fullscreen
+			|| view->maximized == VIEW_AXIS_BOTH) {
+		return false;
+	}
+	if (!view_is_tiled(view)) {
+		return true;
+	}
+	/* Tiled views only with a gap the shadows fit in */
+	struct theme *theme = rc.theme;
+	return rc.shadows_on_tiled
+		&& rc.gap >= theme->window[SSD_ACTIVE].shadow_size
+		&& rc.gap >= theme->window[SSD_INACTIVE].shadow_size;
+}
+
+static void
+hide_shadow(struct view *view)
+{
+	if (view->fx_shadow) {
+		wlr_scene_node_set_enabled(&view->fx_shadow->node, false);
+	}
+}
+
+static void
+update_shadow(struct view *view, int radius)
+{
+	struct theme *theme = rc.theme;
+	enum ssd_active_state state = view->fx_active ? SSD_ACTIVE : SSD_INACTIVE;
+	int sigma = theme->window[state].shadow_size;
+	const float *premultiplied = theme->window[state].shadow_color;
+	float alpha = premultiplied[3];
+
+	struct border margin = ssd_thickness(view);
+	struct wlr_box outline = {
+		.x = -margin.left,
+		.y = -margin.top,
+		.width = view->current.width + margin.left + margin.right,
+		.height = view_effective_height(view, /* use_pending */ false)
+			+ margin.top + margin.bottom,
+	};
+	if (sigma <= 0 || alpha <= 0 || outline.width <= 0 || outline.height <= 0) {
+		hide_shadow(view);
+		return;
+	}
+
+	/* Theme colors are premultiplied, SceneFX shadows take straight alpha */
+	float color[4] = {
+		premultiplied[0] / alpha,
+		premultiplied[1] / alpha,
+		premultiplied[2] / alpha,
+		alpha,
+	};
+	radius = MIN(radius, MIN(outline.width, outline.height) / 2);
+	int dx = theme->window[state].shadow_offset_x;
+	int dy = theme->window[state].shadow_offset_y;
+	int width = outline.width + 2 * sigma;
+	int height = outline.height + 2 * sigma;
+
+	if (!view->fx_shadow) {
+		view->fx_shadow = wlr_scene_shadow_create(view->scene_tree,
+			width, height, radius, sigma, color);
+		die_if_null(view->fx_shadow);
+	}
+	struct wlr_scene_shadow *shadow = view->fx_shadow;
+	wlr_scene_shadow_set_size(shadow, width, height);
+	wlr_scene_shadow_set_corner_radius(shadow, radius);
+	wlr_scene_shadow_set_blur_sigma(shadow, sigma);
+	wlr_scene_shadow_set_color(shadow, color);
+	wlr_scene_shadow_set_clipped_region(shadow, (struct clipped_region){
+		.area = { sigma - dx, sigma - dy, outline.width, outline.height },
+		.corners = corner_radii_all(radius),
+	});
+	wlr_scene_node_set_position(&shadow->node,
+		outline.x - sigma + dx, outline.y - sigma + dy);
+
+	/* Below the decorations, which are lowered when (re)created */
+	if (view->scene_tree->children.next != &shadow->node.link) {
+		wlr_scene_node_lower_to_bottom(&shadow->node);
+	}
+	wlr_scene_node_set_enabled(&shadow->node, true);
+}
+
+void
+view_fx_update(struct view *view)
+{
+	if (!view->mapped || !view->content_tree || !view->surface) {
+		hide_shadow(view);
+		return;
+	}
+
+	int radius = window_radius(view);
+	struct fx_corner_radii content = corner_radii_all(radius);
+	if (view->ssd) {
+		/* Inside the border; the ssd-border.c rounding needs the height */
+		int bw = rc.theme->border_width;
+		int band = MAX(bw, radius);
+		int inner = bw > 0 ? MAX(radius - bw, 0) : radius;
+		bool titlebar = view_titlebar_visible(view);
+		if (bw > 0 && view->current.height < (titlebar ? band : 2 * band)) {
+			inner = 0;
+		}
+		content = titlebar ? corner_radii_bottom(inner)
+			: corner_radii_all(inner);
+	}
+
+	struct buffer_walk walk = {
+		.root = view->surface,
+		.width = view->current.width,
+		.height = view->current.height,
+		.radii = content,
+	};
+	bool client_frame = round_tree(&view->content_tree->node, &walk);
+
+	/* The window capture holds the content alone: round all four sides */
+	walk.radii = corner_radii_all(client_frame ? 0 : radius);
+	round_tree(&view->capture.scene->tree.node, &walk);
+
+	if (client_frame || !want_shadow(view)) {
+		hide_shadow(view);
+	} else {
+		update_shadow(view, radius);
+	}
+}
+
+void
+view_fx_update_all(void)
+{
+	struct view *view;
+	wl_list_for_each(view, &server.views, link) {
+		view_fx_update(view);
+	}
+}
