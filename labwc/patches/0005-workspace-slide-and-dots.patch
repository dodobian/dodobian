diff --git a/include/workspace-slide.h b/include/workspace-slide.h
new file mode 100644
index 0000000..1a8c3af
--- /dev/null
+++ b/include/workspace-slide.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_WORKSPACE_SLIDE_H
+#define LABWC_WORKSPACE_SLIDE_H
+
+#include <stdbool.h>
+
+struct output;
+struct workspace_group;
+
+/*
+ * A switch of workspaces slides, as on macOS: the old workspace leaves the
+ * output to one side while the new one comes in from the other. Both are
+ * snapshots of the output without its top and overlay layers, so a panel
+ * stays where it is, and each is cropped to its output, so nothing spills
+ * onto a neighbouring one. <desktops slideTime=""> sets the duration, 0
+ * (the default) switches at once.
+ */
+
+/* Before the switch: snapshot every output that shows the group */
+void workspace_slide_prepare(struct workspace_group *group);
+/* After the switch: snapshot again and slide; forward = the new one is on the right */
+void workspace_slide_start(struct workspace_group *group, bool forward);
+/* Every frame of the output, before it is rendered */
+void workspace_slide_frame(struct output *output);
+/* Stop at once, e.g. when the output goes away */
+void workspace_slide_cancel(struct output *output);
+
+#endif /* LABWC_WORKSPACE_SLIDE_H */
