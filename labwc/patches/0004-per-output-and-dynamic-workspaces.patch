+/*
+ * Dynamic workspaces, as in GNOME: every group ends with one empty
+ * workspace, and an empty workspace that is not the current one goes
+ * away. The remaining ones are renamed by their position.
+ */
+static void
+group_update_dynamic(struct workspace_group *group)
+{
+	struct workspace *workspace, *tmp;
+	wl_list_for_each_safe(workspace, tmp, &group->workspaces, link) {
+		if (workspace == group->current
+				|| workspace->link.next == &group->workspaces
+				|| workspace_is_occupied(workspace)) {
+			continue;
+		}
+		/* Unmapped and omnipresent views may still live in its tree */
+		struct view *view;
+		wl_list_for_each(view, &server.views, link) {
+			if (view->workspace == workspace) {
+				view_move_to_workspace(view, group->current);
+			}
+		}
+		if (group->last == workspace) {
+			group->last = NULL;
+		}
+		destroy_workspace(workspace);
+	}
+
+	struct workspace *tail =
+		wl_container_of(group->workspaces.prev, tail, link);
+	if (workspace_is_occupied(tail)) {
+		char *name = name_for_index(wl_list_length(&group->workspaces));
+		add_workspace(group, name);
+		free(name);
+	} else if (tail != group->current
+			&& group->current->link.next == &tail->link
+			&& !workspace_is_occupied(group->current)) {
+		/* The current workspace is empty and last but one: it is the tail */
+		struct view *view;
+		wl_list_for_each(view, &server.views, link) {
+			if (view->workspace == tail) {
+				view_move_to_workspace(view, group->current);
+			}
+		}
+		if (group->last == tail) {
+			group->last = NULL;
+		}
+		destroy_workspace(tail);
+	}
+
+	size_t index = 0;
+	wl_list_for_each(workspace, &group->workspaces, link) {
+		char *name = name_for_index(index++);
+		set_name(workspace, name);
+		free(name);
+	}
+}
+
+static void
+handle_update_idle(void *data)
+{
+	server.workspaces.update_idle = NULL;
+	struct workspace_group *group;
+	wl_list_for_each(group, &server.workspaces.groups, link) {
+		group_update_dynamic(group);
+	}
+}
