diff --git a/include/workspaces.h b/include/workspaces.h
index 3a5c6d0..2253e2e 100644
--- a/include/workspaces.h
+++ b/include/workspaces.h
@@ -6,12 +6,32 @@
 #include <wayland-util.h>
 #include <wayland-server-core.h>
 
+struct output;
 struct seat;
 struct server;
+struct view;
 struct wlr_scene_tree;
 
+/*
+ * A set of workspaces that switch together. Without <desktops perOutput>
+ * there is one group spanning all outputs. With it, every output in the
+ * layout has a group of its own, and the global group only holds views
+ * that are on no output (e.g. while all outputs are off).
+ */
+struct workspace_group {
+	struct wl_list link; /* struct server.workspaces.groups */
+	struct output *output; /* NULL for the global group */
+	struct wl_list workspaces; /* struct workspace.link */
+	struct workspace *current;
+	struct workspace *last;
+
+	/* NULL for the global group in per-output mode */
+	struct wlr_ext_workspace_group_handle_v1 *ext_group;
+};
+
 struct workspace {
-	struct wl_list link; /* struct server.workspaces */
+	struct wl_list link; /* struct workspace_group.workspaces */
+	struct workspace_group *group;
 
 	char *name;
 	struct wlr_scene_tree *tree;
@@ -28,4 +48,26 @@ struct workspace *workspaces_find(struct workspace *anchor, const char *name,
 	bool wrap);
 void workspaces_reconfigure(void);
 
+/* The current workspace of the output nearest to the cursor */
+struct workspace *workspaces_current(void);
+/* The group whose workspaces the given output shows (never NULL) */
+struct workspace_group *workspaces_group_for_output(struct output *output);
+/* True if the workspace is the current one of its group */
+bool workspace_is_visible(struct workspace *workspace);
+
+/* Output lifecycle: an output enters or leaves the layout */
+void workspaces_output_added(struct output *output);
+void workspaces_output_removed(struct output *output);
+
+/*
+ * Move the view to its output's group after view->output changed: to the
+ * current workspace of that group, or, while outputs are being rearranged,
+ * to the workspace with the same index, so that windows find their way
+ * back when an output is reconnected.
+ */
+void workspaces_view_output_changed(struct view *view);
+
+/* Views were added, removed or moved: update dynamic workspaces */
+void workspaces_views_changed(void);
+
 #endif /* LABWC_WORKSPACES_H */
