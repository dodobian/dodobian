+static bool
+per_output(void)
+{
+	return server.workspaces.per_output;
+}
+
+static bool
+dynamic(void)
+{
+	return server.workspaces.dynamic;
+}
+
+static size_t
+workspace_index(struct workspace *workspace)
+{
+	size_t index = 0;
+	struct workspace *w;
+	wl_list_for_each(w, &workspace->group->workspaces, link) {
+		if (w == workspace) {
+			return index;
+		}
+		index++;
+	}
+	return 0;
+}
+
+/* Name of the workspace at index (0-based): from <names>, else "<prefix> N" */
+static char *
+name_for_index(size_t index)
+{
+	size_t i = 0;
+	struct workspace_config *conf;
+	wl_list_for_each(conf, &rc.workspace_config.workspaces, link) {
+		if (i++ == index) {
+			return xstrdup(conf->name);
+		}
+	}
+	const char *prefix = rc.workspace_config.prefix
+		? rc.workspace_config.prefix : _("Workspace");
+	struct buf b = BUF_INIT;
+	if (!string_null_or_empty(prefix)) {
+		buf_add_fmt(&b, "%s ", prefix);
+	}
+	buf_add_fmt(&b, "%zu", index + 1);
+	char *name = xstrdup(b.data);
+	buf_reset(&b);
+	return name;
+}
